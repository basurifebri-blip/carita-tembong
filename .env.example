# CARITA TEMBONG — environment variables
# Copy to .env.local and fill in. Never commit real secrets.

# ---- WordPress headless CMS (optional) ----
# Base REST URL of the WordPress site, e.g. https://cms.desatembong.id/wp-json
# Leave blank to keep the built-in placeholders (the build stays fully static).
WORDPRESS_API_URL=

# Custom post type slug for news. Defaults to "posts".
# Set to a custom type (e.g. "berita") once it exists in WordPress.
WORDPRESS_NEWS_TYPE=

# How long (seconds) fetched CMS content is cached before revalidating (ISR).
CMS_REVALIDATE_SECONDS=300

# ---- Site ----
NEXT_PUBLIC_SITE_URL=https://desatembong.id
